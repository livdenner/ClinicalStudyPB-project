        <mxCell id="legend" value="Enums UserRole, StudyStatus e CriterionType e demais campos de Study estão na página Estudos e protocolo.&lt;br/&gt;ConsentStatus é a visão da API: PENDING, GRANTED ou DECLINED." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#000000;fontSize=15;" vertex="1" parent="1">
