        <mxCell id="EligibilityStatus" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;EligibilityStatus&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;PENDING&lt;/div&gt;&lt;div&gt;ELIGIBLE&lt;/div&gt;&lt;div&gt;INELIGIBLE&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="1180" width="360" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ConsentDecision" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ConsentDecision&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;GRANTED&lt;/div&gt;&lt;div&gt;DECLINED&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1140" y="1180" width="200" height="126" as="geometry" />
        </mxCell>
        <mxCell id="ParticipantStatus" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;ParticipantStatus&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&amp;lt;&amp;lt;enumeration&amp;gt;&amp;gt;&lt;/i&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div&gt;ACTIVE&lt;/div&gt;&lt;div&gt;WITHDRAWN&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1360" y="1180" width="200" height="126" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="Respostas são únicas por (candidateId, criterionId). Cada candidato tem no máximo uma inclusão; cada conta tem no máximo uma candidatura ativa por estudo.&lt;br/&gt;evaluatedBy, includedBy, cancelledByUserId, recordedByUserId e withdrawnByUserId referenciam User.id.&lt;br/&gt;O convite guarda só o hash do código, com validade, e é usado uma única vez (usedAt); activationPending indica conta que ainda precisa definir a senha.&lt;br/&gt;O próprio candidato decide o consentimento no app; antes da decisão, a API retorna ConsentStatus.PENDING.&lt;br/&gt;Inclusão exige RECRUITMENT, ELIGIBLE, consentimento GRANTED e vaga. A retirada (RF16) é definitiva, não libera a vaga e cancela as visitas futuras." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#000000;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="1450" width="1500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Enums UserRole, StudyStatus e CriterionType e demais campos de Study e User estão na página Estudos e protocolo.&lt;br/&gt;ConsentStatus (PENDING, GRANTED, DECLINED) e CandidateStatus (INVITED, ACTIVE, CONSENT_PENDING, GRANTED, DECLINED, INCLUDED) são situações calculadas pela API, sem coluna própria." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#000000;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="60" y="1620" width="1500" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
