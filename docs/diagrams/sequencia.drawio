          </mxGeometry>
        </mxCell>
        <mxCell id="rules" value="A decisão é única e imutável e pertence à conta PARTICIPANT dona da candidatura; candidatura de outra conta: 404. O registro é fictício, sem assinatura ou validade clínica.&lt;br/&gt;Cancelada, já incluída, já decidida, não elegível, conta pendente ou estudo fora de RECRUITMENT: 409 (CANDIDATE_CANCELLED, CONSENT_ALREADY_DECIDED, CONSENT_NOT_AVAILABLE ou STUDY_NOT_RECRUITING).&lt;br/&gt;O coordenador só consulta a decisão (GET /api/studies/{studyId}/candidates/{candidateId}/consent); o PUT antigo responde 403 CONSENT_DECIDED_BY_CANDIDATE. Após a inclusão, lockedAfterInclusion bloqueia a decisão." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#000000;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="60" y="1135" width="1840" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
