# Chave de assinatura dos JWTs: Base64 de pelo menos 32 bytes aleatorios.
# Gere com: openssl rand -base64 32
JWT_SECRET_BASE64=gere-uma-chave-com-openssl-rand-base64-32
# Validade do token em segundos (opcional; o padrao e 3600)
JWT_EXPIRATION_SECONDS=3600
